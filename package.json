{
  "name": "passura-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && bunx wrangler deploy",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply passura-sync --local --config wrangler.api.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply passura-sync --remote --config wrangler.api.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.32",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.542.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/ui": "^4.1.10",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.2",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.0.0"
  }
}
